#!/bin/sh
# Minimal mock for Podman (similar structure to mock_docker)

set -e

CMD="$1"
shift || true

case "$CMD" in
    ps)
        if [ "$*" = "-aq" ]; then
            echo "pod123container"
        else
            echo "CONTAINER ID  IMAGE  STATUS"
            echo "pod123container  alpine  Up"
        fi
        ;;
    inspect)
        # Handle --format
        if [ "$1" = "--format" ]; then
            FORMAT="$2"
            CID="$3"
            case "$FORMAT" in
                *'.Name'*) echo "/podman-test" ;;
                *'.State.Running'*) echo "true" ;;
                *'.State.Pid'*) echo "9876" ;;
                *'.SizeRootFs'*) echo "8000000" ;;
                *) echo "unknown" ;;
            esac
            exit 0
        fi
        cat <<'JSON'
{
  "Id": "pod123container",
  "Name": "/podman-test",
  "State": { "Running": true, "Pid": 9876 },
  "SizeRootFs": 8000000
}
JSON
        ;;
    logs)
        echo "podman mock log"
        ;;
    export)
        OUT="$1"
        echo "podman-mock-fs" | tar -cf "$OUT" -T -
        ;;
    commit)
        # podman commit CID temp-tag
        ;;
    save)
        while [ $# -gt 0 ]; do
            case "$1" in
                -o)
                    OUT="$2"
                    shift 2
                    if [ -n "$OUT" ]; then
                        echo "podman-mock-layered-image" | tar -cf "$OUT" -T -
                    fi
                    ;;
                *)
                    shift
                    ;;
            esac
        done
        ;;
    rmi)
        ;;
    *)
        echo "mock-podman: $CMD $*" >&2
        exit 0
        ;;
esac
